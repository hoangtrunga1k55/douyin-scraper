<% const t = (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : (typeof defaultTitle !== 'undefined' ? defaultTitle : 'Tải Video TikTok & Douyin Miễn Phí - Không Watermark'); %>
<% const d = (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : (typeof defaultDesc !== 'undefined' ? defaultDesc : 'Tải video TikTok và Douyin miễn phí, không watermark, không cần đăng nhập. Hỗ trợ TikTok quốc tế và Douyin Trung Quốc, chất lượng HD.'); %>
<% const k = (typeof seo !== 'undefined' && seo && seo.keywords) ? seo.keywords : (typeof defaultKw !== 'undefined' ? defaultKw : 'tải video tiktok, tải video douyin, tiktok downloader, douyin downloader, tải tiktok không watermark, tải douyin không logo'); %>
<% const i = (typeof seo !== 'undefined' && seo && seo.ogImage) ? seo.ogImage : (typeof defaultImg !== 'undefined' ? defaultImg : ''); %>

<title><%= t %></title>
<meta name="description" content="<%= d %>">
<% if (k) { %><meta name="keywords" content="<%= k %>"><% } %>
<meta name="robots" content="<%= (typeof noIndex !== 'undefined' && noIndex) ? 'noindex, nofollow' : 'index, follow' %>">

<meta property="og:title" content="<%= t %>">
<meta property="og:description" content="<%= d %>">
<meta property="og:type" content="website">
<meta property="og:locale" content="vi_VN">
<meta property="og:site_name" content="TikTok & Douyin Downloader">
<% if (i) { %><meta property="og:image" content="<%= i %>"><% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= t %>">
<meta name="twitter:description" content="<%= d %>">
<% if (i) { %><meta name="twitter:image" content="<%= i %>"><% } %>
