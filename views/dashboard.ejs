<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Douyin Downloader</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex flex-col items-center min-h-screen pt-12 pb-10">
  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-2xl">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-bold">Welcome!</h2>
      <a href="/logout" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">Logout</a>
    </div>

    <p class="text-gray-600 mb-4">📧 <strong><%= user.email %></strong></p>

    <div class="mb-6 p-6 bg-blue-50 rounded-lg border border-blue-200">
      <h3 class="text-xl font-bold text-blue-800 mb-2">Your API Credits</h3>
      <p class="text-4xl text-blue-600 font-extrabold"><%= user.credits %></p>
      <p class="text-sm text-gray-600 mt-2">Each API call costs credits. Contact admin to top up.</p>
    </div>

    <div class="mb-6 p-6 bg-gray-50 rounded-lg border border-gray-200">
      <h3 class="text-xl font-bold text-gray-800 mb-2">Your API Token</h3>
      <div class="flex items-center space-x-2">
        <input type="text" readonly value="<%= user.apiToken %>" class="flex-1 bg-white border border-gray-300 rounded py-2 px-3 text-gray-700 font-mono text-sm" onclick="this.select()">
        <form action="/dashboard/regenerate-token" method="POST" onsubmit="return confirm('Are you sure? Your old token will stop working immediately.');">
          <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded">Regenerate</button>
        </form>
      </div>
      <p class="text-sm text-gray-600 mt-2">Pass this in the <code>Authorization: Bearer &lt;token&gt;</code> header.</p>
    </div>

    <!-- Change Password -->
    <div class="mb-4 p-6 bg-purple-50 rounded-lg border border-purple-200">
      <h3 class="text-xl font-bold text-purple-800 mb-3">🔑 Change Password</h3>
      <% if (typeof pwError !== 'undefined' && pwError) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded mb-3 text-sm"><%= pwError %></div>
      <% } %>
      <% if (typeof pwSuccess !== 'undefined' && pwSuccess) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-3 py-2 rounded mb-3 text-sm"><%= pwSuccess %></div>
      <% } %>
      <form action="/dashboard/change-password" method="POST">
        <div class="grid grid-cols-1 gap-3">
          <input type="password" name="currentPassword" placeholder="Current password" required class="border border-gray-300 rounded py-2 px-3 text-sm">
          <input type="password" name="newPassword" placeholder="New password (min 6 chars)" required minlength="6" class="border border-gray-300 rounded py-2 px-3 text-sm">
          <input type="password" name="confirmNewPassword" placeholder="Confirm new password" required minlength="6" class="border border-gray-300 rounded py-2 px-3 text-sm">
          <button type="submit" class="bg-purple-500 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded text-sm">Update Password</button>
        </div>
      </form>
    </div>

    <div class="mt-4 text-center space-x-4">
      <a href="/dashboard/pricing" class="text-green-600 hover:text-green-800 font-bold underline">Nạp Credit</a>
      <a href="/docs" class="text-blue-600 hover:text-blue-800 font-bold underline">API Docs</a>
      <a href="https://www.facebook.com/ztrungflyz" target="_blank" class="text-blue-600 hover:text-blue-800 font-bold underline">Contact Admin</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="text-purple-600 hover:text-purple-800 font-bold underline">Admin Panel</a>
      <% } %>
    </div>
  </div>
</body>
</html>
