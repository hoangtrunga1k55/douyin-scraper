# Server Configuration
PORT=3000

# Douyin Cookie (Required)
# Login to douyin.com in your browser, then copy the cookie string
# You can use browser DevTools > Application > Cookies to get this
DOUYIN_COOKIE=your_douyin_cookie_here

# Download Configuration
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_TIMEOUT=30000

# Proxy (Optional - recommended for non-Chinese IPs)
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

# Telegram Notifications (Optional - for alerting when cookie expires)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
