# Server Configuration
PORT=3000

# Douyin Cookie (Required)
# Login to douyin.com in your browser, then copy the cookie string
# You can use browser DevTools > Application > Cookies to get this
DOUYIN_COOKIE=your_douyin_cookie_here

# Download Configuration
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_TIMEOUT=30000

# Proxy (Optional - recommended for non-Chinese IPs)
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

# Telegram Notifications (Optional - for alerting when cookie expires)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional VPS ops monitoring. Defaults work for production docker compose.
MONITOR_HEALTH_URLS=http://127.0.0.1:3000/api/health
DISK_ALERT_THRESHOLD=85
MEM_ALERT_THRESHOLD=85
SWAP_ALERT_THRESHOLD=50
LOAD_ALERT_THRESHOLD=
ALERT_COOLDOWN_SECONDS=3600
MONITOR_LOG_LOOKBACK=15m
